# Manus Cue invite codes: 5 chars mixing uppercase letters and digits, e.g. 9XAJP
PAGE_TITLE="Manus Cue Invite Code Monitor"
PAGE_SUBTITLE="Manus Cue invite codes posted on X"
SEARCH_QUERY="cue (邀请码 OR 邀请 OR invite OR code)"
CODE_PATTERN='\b[A-Z0-9]{5}\b'
CODE_UPPERCASE=1
CODE_REQUIRE_LETTER_AND_DIGIT=1
CODE_BLOCKLIST="HTTPS,HTTP2"
WINDOW_MINUTES=1440
PORT=8787
